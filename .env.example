OPENAI_API_KEY=
OPENROUTER_API_KEY=
BOOKING_MODEL=openai/gpt-5.2
# OpenRouter alternative:
# BOOKING_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
BOOKING_DATA_DIR=runtime
BOOKING_TIMEZONE=Asia/Kolkata
BOOKING_RESOURCE=advisor
BOOKING_A2A_URL=http://127.0.0.1:8001
# Optional shared demo bearer token. This is not multi-user authentication.
BOOKING_API_TOKEN=
# Only needed for Google-backed synthetic evaluations:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
