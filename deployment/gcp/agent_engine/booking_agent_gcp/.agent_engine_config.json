{
  "display_name": "booking-agent-openrouter-demo",
  "description": "Demonstration-only booking proposal agent; not production or durable storage.",
  "python_version": "3.12",
  "min_instances": 0,
  "max_instances": 1,
  "resource_limits": {
    "cpu": "1",
    "memory": "2Gi"
  },
  "env_vars": {
    "BOOKING_MODEL": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
    "OPENROUTER_API_KEY": {
      "secret": "openrouter-api-key",
      "version": "latest"
    },
    "BOOKING_DATA_DIR": "/tmp/booking-agent",
    "BOOKING_TIMEZONE": "Asia/Kolkata",
    "BOOKING_RESOURCE": "advisor"
  }
}
